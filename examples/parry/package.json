{
  "name": "@fogrexon/glyph-arena-parry-demo",
  "glyphArenaPage": {
    "path": "/parry/",
    "label": "Parry"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('node:fs').copyFileSync('../pickup-demo/public/pickup.wav','public/parry.wav')\" && vite build && node ../../scripts/stamp-dist.mjs parry",
    "build:pages": "node -e \"require('node:fs').copyFileSync('../pickup-demo/public/pickup.wav','public/parry.wav')\" && vite build",
    "preview": "vite preview",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fogrexon/glyph-arena-actions": "workspace:*",
    "@fogrexon/glyph-arena-assets": "workspace:*",
    "@fogrexon/glyph-arena-audio": "workspace:*",
    "@fogrexon/glyph-arena-camera": "workspace:*",
    "@fogrexon/glyph-arena-collide": "workspace:*",
    "@fogrexon/glyph-arena-draw": "workspace:*",
    "@fogrexon/glyph-arena-ecs": "workspace:*",
    "@fogrexon/glyph-arena-gamepad": "workspace:*",
    "@fogrexon/glyph-arena-input": "workspace:*",
    "@fogrexon/glyph-arena-loop": "workspace:*",
    "@fogrexon/glyph-arena-reset": "workspace:*",
    "@fogrexon/glyph-arena-scene": "workspace:*",
    "@fogrexon/glyph-arena-screen": "workspace:*",
    "@fogrexon/glyph-arena-timer": "workspace:*",
    "@fogrexon/glyph-arena-touch": "workspace:*",
    "@fogrexon/glyph-arena-transform": "workspace:*",
    "@fogrexon/glyph-arena-tween": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
