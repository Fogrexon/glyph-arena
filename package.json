{
  "name": "glyph-arena",
  "private": true,
  "scripts": {
    "assemble:site": "node scripts/assemble-site.mjs",
    "build": "pnpm -r build",
    "camp:bot": "node scripts/play-bot.mjs camp",
    "check:pack": "node scripts/check-pack-rebuilds.mjs",
    "check:package-entry-points": "node scripts/check-package-entry-points.mjs",
    "check:readme": "node scripts/check-umbrella-readme.mjs",
    "check:readme-example": "node scripts/require-fresh.mjs package:glyph-arena && node scripts/extract-readme.mjs && tsc -p fixtures/readme/tsconfig.published.json",
    "check:served": "node scripts/check-served-bundles.mjs",
    "docs:render": "node scripts/render-docs.mjs",
    "e2e:demo": "node scripts/e2e-demo.mjs",
    "e2e:flake": "node scripts/e2e-repeat.mjs 10 node scripts/e2e-tutorial-phone.mjs",
    "e2e:published": "node scripts/e2e-published.mjs",
    "e2e:readme": "node scripts/e2e-readme.mjs",
    "e2e:runner": "node scripts/e2e-runner.mjs",
    "e2e:tutorial": "node scripts/e2e-tutorial.mjs && node scripts/e2e-tutorial-phone.mjs",
    "march:bot": "node scripts/play-bot.mjs march",
    "measure:parry-run": "node scripts/measure-parry-run.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "readme:extract": "node scripts/extract-readme.mjs",
    "runner:bot": "node scripts/play-bot.mjs runner",
    "smoke:pack-install": "node scripts/smoke-pack-install.mjs",
    "test": "pnpm -r test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "tutorial:extract": "node scripts/extract-tutorials.mjs",
    "typecheck": "pnpm -r typecheck",
    "typecheck:public-api": "node scripts/require-fresh.mjs --packages && tsc -p fixtures/public-api/tsconfig.json"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
