diff --git a/examples/runner/test/level.test.ts b/examples/runner/test/level.test.ts
new file mode 100644
index 0000000..c303e12
--- /dev/null
+++ b/examples/runner/test/level.test.ts
@@ -0,0 +1,36 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { LEVEL, TILE, goalPoint, isHazardTile, isSolidTile, levelColumns, spawnPoint, tileAt } from "../src/level.ts";
+
+test("the level has a spawn, a goal and something to die on", () => {
+  const spawn = spawnPoint();
+  const goal = goalPoint();
+  assert.ok(goal !== null, "no goal in the level");
+  assert.ok(goal.x > spawn.x, "the goal has to be ahead of the spawn");
+  let hazards = 0;
+  for (let row = 0; row < LEVEL.length; row += 1) {
+    for (let column = 0; column < levelColumns(); column += 1) {
+      if (isHazardTile(column, row)) hazards += 1;
+    }
+  }
+  assert.ok(hazards > 0, "a slice needs something that kills");
+});
+
+test("the spawn stands on solid ground, not in the air", () => {
+  const spawn = spawnPoint();
+  const column = Math.floor(spawn.x / TILE);
+  const row = Math.floor(spawn.y / TILE);
+  assert.ok(isSolidTile(column, row + 1), "nothing under the spawn");
+  assert.equal(tileAt(column, row), "spawn");
+});
+
+test("outside the level is sky, not a wall", () => {
+  assert.equal(tileAt(-3, 0), "empty");
+  assert.equal(tileAt(0, -2), "empty");
+  assert.equal(tileAt(levelColumns() + 5, 2), "empty");
+});
+
+test("the level is wide enough to be a run, not a room", () => {
+  assert.ok(levelColumns() * TILE > 1200, `only ${levelColumns() * TILE} px wide`);
+});
