{
  "name": "@fogrexon/glyph-arena-tutorial-fixture",
  "private": true,
  "type": "module",
  "description": "Compiles and runs the tutorial's programs, extracted from docs/tutorial.md",
  "scripts": {
    "extract": "node ../../scripts/extract-tutorials.mjs",
    "dev": "node ../../scripts/extract-tutorials.mjs && vite",
    "typecheck": "node ../../scripts/extract-tutorials.mjs && tsc -p tsconfig.json --noEmit",
    "build": "node ../../scripts/extract-tutorials.mjs && vite build && node ../../scripts/stamp-dist.mjs tutorial"
  },
  "dependencies": {
    "@fogrexon/glyph-arena": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
