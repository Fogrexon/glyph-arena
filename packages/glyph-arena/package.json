{
  "name": "@fogrexon/glyph-arena",
  "version": "0.1.2",
  "description": "The Glyph Arena 2D game runtime as one package: the 14 modules bundled into a single ESM build with self-contained type declarations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fogrexon/glyph-arena.git"
  },
  "homepage": "https://fogrexon.github.io/glyph-arena/",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "game",
    "2d",
    "canvas",
    "ecs",
    "runtime"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/write-entry-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
