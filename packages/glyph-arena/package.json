{
  "name": "@fogrexon/glyph-arena",
  "version": "0.1.0",
  "description": "The Glyph Arena 2D game runtime as one package: the 14 modules bundled into a single ESM/CJS build with self-contained type declarations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "game",
    "2d",
    "canvas",
    "ecs",
    "runtime"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/write-entry-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
